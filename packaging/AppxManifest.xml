<?xml version="1.0" encoding="utf-8"?>
<!--
  Package definition for Mandala Explorer.

  Identity must match what Partner Center reserved, exactly. The Store rejects
  a package whose Name or Publisher differs from the reservation, and the
  Publisher here is the CN of the certificate the Store signs with rather than
  anything readable.

  Version is rewritten at build time: the Store requires the revision (fourth)
  field to be 0, and each submission to be higher than the last.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="FamoceSuccellion.MandalaExplorer"
    Publisher="CN=58ADE1FF-9537-4A21-932D-A763EDF32719"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Mandala Explorer</DisplayName>
    <PublisherDisplayName>Famoce Succellion</PublisherDisplayName>
    <Logo>Assets\StoreLogo.scale-100.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Media Foundation hardware decoding needs a real desktop; 10.0.19041
         is the first build this has been tested against. -->
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ja-jp" />
  </Resources>

  <Applications>
    <Application Id="MandalaExplorer" Executable="mandala.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Mandala Explorer"
        Description="A file browser for folders full of pictures and video, with very large thumbnails and many videos playing at once."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.scale-100.png"
        Square44x44Logo="Assets\Square44x44Logo.scale-100.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.scale-100.png"
          Square310x310Logo="Assets\Square310x310Logo.scale-100.png"
          Square71x71Logo="Assets\Square71x71Logo.scale-100.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.scale-100.png" BackgroundColor="transparent" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop app packaged as MSIX, not a sandboxed one: it browses
         whatever folder it is pointed at, which is the entire point of it. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
